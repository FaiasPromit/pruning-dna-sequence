{
  "config_name": "zhihan1996/DNABERT-2-117M",
  "trust_remote_code": true,
  "tokenizer_name": "../tokenizers/DB2-HRG",
  "train_file": "/path/to/HRG_corpus/DB2-HRG/train.txt",
  "validation_file": "/path/to/HRG_corpus/DB2-HRG/dev.txt",
  "max_seq_length": 128,
  "output_dir": "/path/to/outputs/pretrain_DB2-HRG_BPAS_8",
  "do_eval": true,
  "dataloader_drop_last": true,
  "mlm_probability": 0.15,
  "learning_rate": 0.0005,
  "warmup_steps": 1800,
  "max_steps": 30000,
  "weight_decay": 1e-05,
  "adam_beta1": 0.9,
  "adam_beta2": 0.98,
  "adam_epsilon": 1e-06,
  "per_device_train_batch_size": 128,
  "per_device_eval_batch_size": 128,
  "gradient_accumulation_steps": 1,
  "preprocessing_num_workers": 16,
  "bf16": true,
  "max_grad_norm": 1,
  "dataloader_num_workers": 4,
  "dataloader_pin_memory": true,
  "ddp_timeout": 7200,
  "eval_steps": 1500,
  "save_steps": 1500,
  "save_total_limit": 2,
  "seed": 42,
  "bpas_delta_start": 0.001,
  "bpas_delta_end": 0.01,
  "graceful_exit_epoch": 32
}
