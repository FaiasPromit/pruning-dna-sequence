{
  "config_name": "zhihan1996/DNABERT-2-117M",
  "trust_remote_code": true,
  "tokenizer_name": "../tokenizers/DB2-MSG",
  "train_file": "/path/to/MSG_corpus/train.txt",
  "validation_file": "/path/to/MSG_corpus/dev.txt",
  "max_seq_length": 128,
  "output_dir": "/path/to/outputs/pretrain_DB2-MSG_LP_0%",
  "do_eval": true,
  "dataloader_drop_last": true,
  "mlm_probability": 0.15,
  "learning_rate": 0.0005,
  "warmup_steps": 30000,
  "max_steps": 500000,
  "weight_decay": 1e-05,
  "adam_beta1": 0.9,
  "adam_beta2": 0.98,
  "adam_epsilon": 1e-06,
  "per_device_train_batch_size": 128,
  "per_device_eval_batch_size": 128,
  "gradient_accumulation_steps": 1,
  "preprocessing_num_workers": 16,
  "bf16": true,
  "max_grad_norm": 1,
  "dataloader_num_workers": 4,
  "dataloader_pin_memory": true,
  "ddp_timeout": 7200,
  "eval_steps": 10000,
  "save_steps": 10000,
  "save_total_limit": 2,
  "seed": 42,
  "pruning_enabled": true,
  "pruning_lower_threshold": 0.0,
  "pruning_upper_threshold": 0.0,
  "pruning_window": 1,
  "graceful_exit_epoch": 47
}
