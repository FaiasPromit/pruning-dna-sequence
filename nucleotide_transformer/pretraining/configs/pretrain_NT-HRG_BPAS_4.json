{
  "vocab_file": "../tokenizer/vocab.txt",
  "train_file": "/path/to/HRG_corpus/NT-HRG/train.txt",
  "validation_file": "/path/to/HRG_corpus/NT-HRG/dev.txt",
  "output_dir": "/path/to/outputs/pretrain_NT-HRG_BPAS_4",
  "hidden_size": 1280,
  "num_hidden_layers": 24,
  "num_attention_heads": 20,
  "intermediate_size": 5120,
  "vocab_size": 4105,
  "max_position_embeddings": 1003,
  "hidden_dropout_prob": 0.0,
  "attention_probs_dropout_prob": 0.0,
  "token_dropout": true,
  "position_embedding_type": "absolute",
  "max_tokens_per_sequence": 1000,
  "mlm_probability": 0.15,
  "random_replace_fraction": 0.1,
  "max_steps": 50000,
  "warmup_steps": 16000,
  "peak_lr": 0.0001,
  "start_lr": 5e-05,
  "weight_decay": 0.0,
  "adam_beta1": 0.9,
  "adam_beta2": 0.999,
  "adam_epsilon": 1e-08,
  "max_grad_norm": 1.0,
  "per_device_train_batch_size": 6,
  "per_device_eval_batch_size": 6,
  "gradient_accumulation_steps": 7,
  "bf16": true,
  "eval_steps": 5000,
  "save_steps": 5000,
  "save_total_limit": 50,
  "logging_steps": 100,
  "dataloader_num_workers": 4,
  "seed": 42,
  "overwrite_output_dir": false,
  "bpas_enabled": true,
  "bpas_delta_start": 0.0001,
  "bpas_delta_end": 0.001,
  "bpas_min_batches_fraction": 0.0,
  "graceful_exit_epoch": 99
}
